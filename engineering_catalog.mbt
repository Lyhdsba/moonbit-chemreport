}

///|
pub fn find_engineering_metrics(term : String) -> Array[EngineeringMetric] {
  let query = term.trim().to_lower()
  let matches : Array[EngineeringMetric] = []
  for item in engineering_metric_catalog() {
    if query == "" ||
      item.id.contains(query) ||
      item.area.contains(query) ||
      item.name.to_lower().contains(query) ||
      item.equation.contains(query) {
      matches.push(item)
    }
  }
  matches
}

///|
pub fn engineering_metric_areas() -> Array[String] {
  let areas : Array[String] = []
  for item in engineering_metric_catalog() {
    if !areas.contains(item.area) {
      areas.push(item.area)
    }
  }
  areas
}
